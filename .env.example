# Copy this file to .env and fill in the values you want to change.
# .env stays on your machine. It is listed in .gitignore.
# Lines starting with # are comments. Blank values are ignored.

# ElevenLabs only. Leave this empty to use the local Whisper engine.
# Get a key from https://elevenlabs.io and paste it after the equals sign.
ELEVENLABS_API_KEY=

# Which engine runs when you do not pass --engine.
# whisper     local, free, no key
# elevenlabs  cloud, needs the key above
TRANSCRIBER_DEFAULT_ENGINE=whisper

# Whisper model size. Larger models are more accurate and slower.
# tiny, base, small, medium, or large-v3
TRANSCRIBER_WHISPER_MODEL=base

# How Whisper stores numbers. int8 is the CPU-friendly default.
# TRANSCRIBER_WHISPER_COMPUTE_TYPE=int8

# ElevenLabs model id. Used only when the engine is elevenlabs.
# TRANSCRIBER_ELEVENLABS_MODEL=scribe_v2

# Target length of one chunk, in seconds. 600 is 10 minutes.
# TRANSCRIBER_CHUNK_SECONDS=600

# How far, in seconds, to search around a cut for a silence.
# TRANSCRIBER_SILENCE_WINDOW_SECONDS=60

# Silence threshold in decibels, and the shortest silence that counts.
# TRANSCRIBER_SILENCE_NOISE_DB=-35
# TRANSCRIBER_SILENCE_MIN_DURATION=0.4

# Language detection: how many clips, and how long each clip is.
# TRANSCRIBER_LANGUAGE_SAMPLES=3
# TRANSCRIBER_LANGUAGE_CLIP_SECONDS=30

# Retries after a temporary engine failure. Delay grows as base * 2^attempt.
# TRANSCRIBER_MAX_RETRIES=3
# TRANSCRIBER_RETRY_BASE_DELAY=1.0

# Limit for one ffmpeg or HTTP call, in seconds.
# TRANSCRIBER_REQUEST_TIMEOUT_SECONDS=600

# Extensions the command accepts. Comma-separated, no dots.
# TRANSCRIBER_SUPPORTED_EXTENSIONS=wav,mp3,m4a,flac,ogg,opus,aac,webm,mp4
